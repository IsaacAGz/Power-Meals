# Copy to .env and fill in. On the server: chown to the app user and chmod 600.
# Never commit real values.

# --- Public (inlined into the browser bundle at build time) ---
# MapTiler key for the locations map; restrict it to the site's domains in the MapTiler dashboard.
NEXT_PUBLIC_MAPTILER_KEY=
# Canonical origin (https://powermeals.mx in production). Also builds the Openpay return URL on the server,
# and is inlined at build time there too, so rebuild after changing it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- PostgreSQL (bound to 127.0.0.1 only) ---
DATABASE_URL=postgres://powermeals:CHANGE_ME@127.0.0.1:5432/powermeals
DATABASE_POOL_MAX=10

# --- Redis (bound to 127.0.0.1, requirepass set) ---
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0
# Sliding TTL for anonymous sessions and guest carts (24h).
REDIS_SESSION_TTL_SECONDS=86400

# --- Auth (Phase 1) ---
# Argon2id secret ("pepper"), at least 32 characters; generate with: openssl rand -base64 32
# Changing it invalidates every stored password, so back it up with the database credentials.
PASSWORD_PEPPER=

# --- Openpay (Phase 2) ---
OPENPAY_MERCHANT_ID=
OPENPAY_PRIVATE_KEY=
# true -> https://sandbox-api.openpay.mx, false -> https://api.openpay.mx
OPENPAY_SANDBOX_MODE=true
# Basic-auth credentials entered when registering the webhook in the Openpay dashboard.
# Required in production; the webhook rejects every request while they are unset.
OPENPAY_WEBHOOK_USER=
OPENPAY_WEBHOOK_PASSWORD=

# --- AWS SQS kitchen dispatch (Phase 3) ---
# Credentials come from the EC2 instance role (sqs:SendMessage on this queue only). With no queue URL,
# paid orders are still recorded but no ticket is sent, and enabling it later does not print old orders.
AWS_REGION=us-west-2
SQS_QUEUE_URL=
# Only for a local SQS emulator; leave empty on AWS.
SQS_ENDPOINT=

# --- Registration (Cloudflare Turnstile) ---
# Both are required before a public account can be created. The site key is public and is inlined at build time.
# A missing or rejected token does not create a user.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Order email (Amazon SES) ---
# Verified from-address in AWS_REGION. The message goes to the email stored on the order, once, when it
# first becomes paid. Unset means that row is recorded as skipped and is not sent when this is set later.
ORDER_EMAIL_FROM=

# --- Order WhatsApp (Cloud API), only when the order has no email ---
# All three are required. Unset means that row is recorded as skipped and is not sent when these are set later.
# The template is one approved es_MX utility template. Body variables, in order: first name, order number, receipt link.
# WHATSAPP_PHONE_NUMBER_ID is the phone number id from the API setup page, not the display number.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
