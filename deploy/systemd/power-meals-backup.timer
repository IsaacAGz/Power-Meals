[Unit]
Description=Dump PostgreSQL to S3 every night

[Timer]
# 03:30 in Tijuana, after the kitchens close. The time zone is explicit so the server can stay on UTC.
OnCalendar=*-*-* 03:30:00 America/Tijuana
# Run at boot if the instance was off at 03:30.
Persistent=true
RandomizedDelaySec=5min
AccuracySec=1min

[Install]
WantedBy=timers.target
