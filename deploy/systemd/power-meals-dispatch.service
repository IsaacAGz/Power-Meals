[Unit]
Description=Power Meals: retry kitchen tickets that could not be sent to SQS
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=powermeals
Group=powermeals
WorkingDirectory=/srv/power-meals
EnvironmentFile=/srv/power-meals/.env
Environment=NODE_ENV=production
# Same command as `npm run kitchen:dispatch`; adjust the node path to match power-meals.service.
ExecStart=/usr/bin/node node_modules/tsx/dist/cli.mjs --conditions=react-server scripts/dispatch-kitchen-tickets.ts
TimeoutStartSec=120

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
