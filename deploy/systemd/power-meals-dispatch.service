[Unit]
Description=Power Meals: retry kitchen tickets that could not be sent to SQS
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=powermeals
Group=powermeals
WorkingDirectory=/srv/power-meals/current
EnvironmentFile=/srv/power-meals/shared/.env
Environment=NODE_ENV=production
# Lets rsyslog copy this unit's JSON lines to /var/log/power-meals/app.log for CloudWatch (deploy/rsyslog).
SyslogIdentifier=power-meals-dispatch
# Same command as `npm run kitchen:dispatch`; adjust the node path to match power-meals.service.
ExecStart=/usr/bin/node node_modules/tsx/dist/cli.mjs --conditions=react-server scripts/dispatch-kitchen-tickets.ts
TimeoutStartSec=120

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
