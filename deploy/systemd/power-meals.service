[Unit]
Description=Power Meals Next.js server
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target postgresql.service redis-server.service

[Service]
Type=simple
User=powermeals
Group=powermeals
WorkingDirectory=/srv/power-meals/current
EnvironmentFile=/srv/power-meals/shared/.env
Environment=NODE_ENV=production
# Lets rsyslog copy this unit's JSON lines to /var/log/power-meals/app.log for CloudWatch (deploy/rsyslog).
SyslogIdentifier=power-meals
# Adjust the node path if Node is installed via nvm or another manager (check with `which node`).
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# .next/cache is written at runtime; current is a symlink, so allow the releases it can point to.
ReadWritePaths=/srv/power-meals/releases

[Install]
WantedBy=multi-user.target
