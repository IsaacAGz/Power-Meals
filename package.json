{
  "name": "power-meals",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed-from-static-data.ts",
    "db:studio": "drizzle-kit studio",
    "user:create-staff": "tsx --env-file-if-exists=.env scripts/create-staff-user.ts",
    "kitchen:dispatch": "tsx --conditions=react-server --env-file-if-exists=.env scripts/dispatch-kitchen-tickets.ts",
    "orders:notify": "tsx --conditions=react-server --env-file-if-exists=.env scripts/notify-orders.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1152.0",
    "@aws-sdk/client-sqs": "^3.1152.0",
    "@node-rs/argon2": "^2.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "maplibre-gl": "^6.11.2",
    "motion": "^13.4.6",
    "next": "16.3.7",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
