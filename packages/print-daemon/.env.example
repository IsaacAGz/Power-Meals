# Copy to .env on the kitchen PC and chmod 600.

# --- Queue ---
QUEUE_URL=https://sqs.us-west-2.amazonaws.com/123456789012/power-meals-kitchen
AWS_REGION=us-west-2
# IAM user limited to ReceiveMessage, DeleteMessage and ChangeMessageVisibility on that queue.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- This kitchen ---
# kitchen_facilities.id (UUID), not the slug:
#   psql "$DATABASE_URL" -c "select slug, id from kitchen_facilities"
KITCHEN_FACILITY_ID=

# --- Printer ---
# tcp://192.168.1.50:9100 (network printer, raw port), file:/dev/usb/lp0 (USB on Linux), or stdout (preview).
PRINTER_TARGET=stdout
# 48 for 80mm paper with the default font; 42 on some printers.
PRINTER_COLUMNS=48
PRINTER_TIMEOUT_MS=10000
# Ask the printer for its paper sensor before each job (tcp only). Leave off unless the printer answers DLE EOT 4.
PRINTER_CHECK_STATUS=false

# --- Retries ---
# First wait after a failed print, doubled on each failure and capped at 300 (60-300).
PRINT_RETRY_VISIBILITY_SECONDS=120
# How long another kitchen's ticket stays hidden after this daemon hands it back (0-300).
OTHER_FACILITY_VISIBILITY_SECONDS=5
